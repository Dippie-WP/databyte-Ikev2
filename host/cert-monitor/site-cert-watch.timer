[Unit]
Description=Per-site TLS certificate watch + auto-renewal activation (Databyte VPN site)

[Timer]
# 4x daily, offset from certbot.timer (which runs at 00:00 and 12:00 UTC).
# The 01:00/13:00 runs deliberately land AFTER a certbot run, so the watcher
# verifies the result of that renewal - including whether the deploy hook
# actually installed the renewed cert into strongswan.
OnCalendar=*-*-* 01,07,13,19:00:00 UTC
Persistent=true
Unit=site-cert-watch.service

[Install]
WantedBy=timers.target
